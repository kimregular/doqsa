# Export these variables in the shell before running bootRun; this file is not loaded automatically.
# External services are optional for local API development.
# OCR provider: none (default) | local (fixed offline response) | gemini. openai and grok are reserved.
OCR_PROVIDER=gemini
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# local, s3 or supabase. S3 uses the AWS default credentials chain.
STORAGE_PROVIDER=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OCR_QUEUE_CONCURRENCY=2
OCR_QUEUE_POLL_DELAY_MS=1000

# Supabase hosted: copy endpoint, region and S3 credentials from Storage settings.
# Direct Docker endpoint: http://supabase-storage:5000/s3 (inside the dev container).
# Public endpoint must be reachable by the uploading client; omit to reuse endpoint.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_PUBLIC_ENDPOINT=
SUPABASE_STORAGE_BUCKET=doqsa-images
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_REGION=local
