# Export these variables in the shell before running bootRun; this file is not loaded automatically.
# External services are optional for local API development. Actual OCR requires Gemini.
OCR_PROVIDER=google-genai
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# local or s3. S3 uses the AWS default credentials chain.
STORAGE_PROVIDER=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OCR_QUEUE_CONCURRENCY=2
OCR_QUEUE_POLL_DELAY_MS=1000
